# Copy to a private, untracked runtime file. Never commit real values.
LLM_BIND_ADDRESS=100.64.0.1
LLM_PORT=18000
LLM_API_KEY=replace-with-a-long-random-secret

# Optional only when the public artifact download requires authentication.
HUGGING_FACE_HUB_TOKEN=

# Qualified single-RTX-4090 profile. Change only through a measured requalification.
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=1
LLM_GPU_MEMORY_UTILIZATION=0.95
LLM_KV_CACHE_DTYPE=fp8
