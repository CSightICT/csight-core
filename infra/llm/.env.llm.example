# Copy to a private, untracked runtime file. Never commit real values.
LLM_BIND_ADDRESS=100.64.0.1
LLM_PORT=18000
LLM_API_KEY=replace-with-a-long-random-secret

# Runnable candidates require an owner-controlled host cache so preflight can verify every file.
# Keep the env file and evidence directory owner-only (0600 and 0700 respectively).
LLM_MODEL_CACHE_DIR=/srv/csight/hf-cache
QWEN4090_SNAPSHOT_DIR=/srv/csight/hf-cache/hub/models--Qwen--Qwen3-8B-FP8/snapshots/220b46e3b2180893580a4454f21f22d3ebb187d3
QWEN4090_DEPENDENCY_LOCK_FILE=/srv/csight/release-evidence/vllm-v0.26.0-lock.txt
QWEN4090_SBOM_FILE=/srv/csight/release-evidence/vllm-v0.26.0-sbom.cdx.json
QWEN4090_QUANTIZATION_RECIPE_FILE=/srv/csight/release-evidence/qwen3-8b-fp8-recipe.json
QWEN4090_CALIBRATION_MANIFEST_FILE=/srv/csight/release-evidence/qwen3-8b-fp8-calibration.json
QWEN4090_PREFLIGHT_OUTPUT_DIR=/srv/csight/release-evidence/host-preflight
LLM_HF_HUB_OFFLINE=1
LLM_TRANSFORMERS_OFFLINE=1

# Optional only when the public artifact download requires authentication.
HUGGING_FACE_HUB_TOKEN=

# Qualified single-RTX-4090 profile. Change only through a measured requalification.
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=1
LLM_GPU_MEMORY_UTILIZATION=0.95
LLM_KV_CACHE_DTYPE=fp8
