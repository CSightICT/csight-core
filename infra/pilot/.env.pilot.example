# Copy to infra/pilot/.env.pilot, fill every value, then run:
#   chmod 600 infra/pilot/.env.pilot
# This file contains placeholders only. It must never contain a real credential in Git.

ENVIRONMENT=pilot
CSIGHT_IMAGE_TAG=
PILOT_RELEASE_COMMIT=

# Core private credentials. Use generated values, not these empty placeholders.
POSTGRES_DB=csight
POSTGRES_USER=csight
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=csight
RABBITMQ_DEFAULT_PASS=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=csight-evidence
JWT_SECRET_KEY=

# Strict non-bypass runtime login password files. Each file must be an absolute,
# owner-only regular file containing exactly one non-empty line.
API_DATABASE_LOGIN=csight_api_login
WORKER_DATABASE_LOGIN=csight_worker_login
DISPATCHER_DATABASE_LOGIN=csight_dispatcher_login
API_DATABASE_PASSWORD_HOST_FILE=
WORKER_DATABASE_PASSWORD_HOST_FILE=
DISPATCHER_DATABASE_PASSWORD_HOST_FILE=
DATABASE_RLS_REQUIRED=true

# OIDC Authorization Code + PKCE. HTTPS is mandatory in this non-local profile.
LEGACY_PASSWORD_AUTH_ENABLED=false
OIDC_ENABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid,email,profile
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_MAPPINGS={}
OIDC_RETURN_PATH_ALLOWLIST=/cases,/reviews
OIDC_TLS_VERIFY=true
OIDC_ALLOW_INSECURE_HTTP=false
OIDC_COOKIE_SECURE=true

# Required OTLP/HTTP collector endpoint. Its observed delivery remains a release gate.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=csight-pilot
OTEL_EXPORTER=otlp_http
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# One approved customer tenant and explicit retention contract.
SENSITIVE_PAYLOAD_RETENTION_POLICY_VERSION=
SENSITIVE_PAYLOAD_RETENTION_DAYS=
PRIVACY_LIFECYCLE_AUTOMATION_ENABLED=true
PRIVACY_LIFECYCLE_TENANT_ID=11111111-1111-4111-8111-111111111111

# One customer-owned Ed25519 signed intake source. Provision the dedicated active,
# no-role service actor and public key separately; this profile never generates a key.
# Keep public_key_file at the fixed container path below.
SIGNED_INTAKE_ENABLED=true
SIGNED_INTAKE_SOURCES={"pilot-customer-key-v1":{"source_id":"pilot-customer-intake","tenant_id":"11111111-1111-4111-8111-111111111111","actor_user_id":"22222222-2222-4222-8222-222222222222","provenance":"pilot.customer.integration","public_key_file":"/run/config/signed_intake_public_key.pem"}}
SIGNED_INTAKE_PUBLIC_KEY_HOST_FILE=
SIGNED_INTAKE_MAX_BODY_BYTES=131072
SIGNED_INTAKE_CLOCK_SKEW_SECONDS=300

# Signed, release-qualified model runtime. Mock providers are rejected by preflight.
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_MODEL_VERSION=
LLM_MODEL_REVISION=
LLM_TASK_RUNTIMES=
MODEL_RELEASE_ENFORCEMENT=true
# Current pilot enforcement scope is PRODUCT_DEFECT_TEXT_EXTRACTION_V2 only.
# This identity must equal the active route plan selected for worker-model.
MODEL_ROUTE_ENFORCEMENT=true
MODEL_ROUTE_DEPLOYMENT_ID=onprem-4090-primary
MODEL_RELEASE_SIGNING_PUBLIC_KEY_HOST_FILE=
MODEL_RELEASE_SIGNING_KEY_ID=
LLM_ARTIFACT_CONTENT_DIGEST=
LLM_RUNTIME_IMAGE_DIGEST=
LLM_DEPENDENCY_LOCK_DIGEST=
LLM_SBOM_DIGEST=
VISION_PROVIDER=remote
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL_ID=
VISION_MODEL_VERSION=
VISION_MODEL_REVISION=
EMBEDDING_BASE_URL=

# Browser-visible Evidence links must terminate at the approved HTTPS gateway.
MINIO_PRESIGNED_ENDPOINT=
MINIO_PRESIGNED_SECURE=true

# Existing external WAL staging directory; preflight checks it without writing.
POSTGRES_WAL_ARCHIVE_PATH=

# PII-free, immutable release qualification evidence.
PILOT_QUALIFICATION_EVIDENCE=
PILOT_QUALIFICATION_EVIDENCE_MAX_AGE_HOURS=24

# Current five-artifact recovery set. Verification reads and hashes only.
PILOT_RESTORE_MANIFEST=
PILOT_POSTGRES_BASE_BACKUP=
PILOT_POSTGRES_WAL_ARCHIVE=
PILOT_MINIO_VERSION_INVENTORY=
PILOT_MINIO_VERSION_BACKUP=
PILOT_RUNTIME_VERSION_MANIFEST=
PILOT_RESTORE_QUALIFICATION_REPORT=

# Optional loopback port overrides. Do not publish Core data services publicly.
API_PORT=8000
WEB_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
