# Application (non-sensitive sample values only)
APP_NAME=csight-core-api
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
API_SCHEMA_VERSION=1.0
READINESS_TIMEOUT_SECONDS=2
DATABASE_ECHO=false

# OpenTelemetry is network-free by default. Limited-pilot production requires
# OTEL_ENABLED=true, OTEL_EXPORTER=otlp_http, an endpoint, and a separate observed
# trace+metric delivery qualification; configuration checks never call Collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=csight-core
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated header=value pairs. Treat values as deployment secrets.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=30

# Local PoC authentication (replace with a random secret of at least 32 bytes)
JWT_SECRET_KEY=change-me-for-local-jwt-use-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=csight-core
JWT_AUDIENCE=csight-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LEGACY_PASSWORD_AUTH_ENABLED=true

# Enterprise OIDC Authorization Code + PKCE. Disabled for legacy local/test login.
# Production readiness and limited-pilot qualification fail until this is fully configured.
OIDC_ENABLED=false
OIDC_PROVIDER_KEY=enterprise
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid,email,profile
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_GROUPS_CLAIM=groups
# Exact IdP group -> one tenant slug and the maximum roles allowed for that mapping.
# Current active local user/tenant/roles remain authoritative after email lookup.
OIDC_GROUP_MAPPINGS={}
OIDC_RETURN_PATH_ALLOWLIST=/cases,/reviews
OIDC_CONNECT_TIMEOUT_SECONDS=3
OIDC_READ_TIMEOUT_SECONDS=5
OIDC_MAX_RESPONSE_BYTES=1048576
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_TLS_VERIFY=true
# Local/test qualification only. The application rejects this outside local/test.
OIDC_ALLOW_INSECURE_HTTP=false
OIDC_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
OIDC_SESSION_IDLE_TIMEOUT_SECONDS=1800
OIDC_SESSION_EXPIRY_WARNING_SECONDS=300
OIDC_COOKIE_NAME=csight_session
OIDC_COOKIE_SECURE=true
OIDC_COOKIE_SAME_SITE=lax

# Optional generic machine-to-machine Case intake. Each JSON object key is the
# signed header key ID; tenant/source identity comes only from this deployment
# mapping, never from the request body. Public key files must be protected PEM.
SIGNED_INTAKE_ENABLED=false
SIGNED_INTAKE_SOURCES={}
# Example shape (replace all UUIDs/paths; do not copy as-is):
# SIGNED_INTAKE_SOURCES={"crm-key-2026":{"source_id":"customer-crm","tenant_id":"00000000-0000-0000-0000-000000000000","actor_user_id":"00000000-0000-0000-0000-000000000000","provenance":"signed/crm/v1","public_key_file":"/run/secrets/crm-intake-public.pem"}}
SIGNED_INTAKE_MAX_BODY_BYTES=131072
SIGNED_INTAKE_CLOCK_SKEW_SECONDS=300

# Explicit local/test seed only. Keep passwords empty until invoking `make seed`.
DEVELOPMENT_SEED_ENABLED=false
DEVELOPMENT_SEED_ADMIN_PASSWORD=
DEVELOPMENT_SEED_REVIEWER_PASSWORD=
DEVELOPMENT_SEED_QUALITY_VIEWER_PASSWORD=

# Sprint 5A Policy Engine is deterministic and has no provider-specific environment variables.

# Core infrastructure
POSTGRES_DB=csight
POSTGRES_USER=csight
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://csight:change-me-for-local-development@127.0.0.1:5432/csight
# Optional password-only secret file for a direct process. When configured,
# DATABASE_URL must omit the password; the resolved URL is never printed.
DATABASE_PASSWORD_FILE=
# Limited-pilot containers use distinct login roles granted to the NOLOGIN
# groups created by migration 0020. compose.rls.yml reads the three passwords
# from private host files and mounts them as Docker secrets. Keep these empty for
# legacy local owner mode; never store password values in this file.
API_DATABASE_URL=
WORKER_DATABASE_URL=
DISPATCHER_DATABASE_URL=
MIGRATION_DATABASE_URL=
API_DATABASE_LOGIN=csight_api_login
WORKER_DATABASE_LOGIN=csight_worker_login
DISPATCHER_DATABASE_LOGIN=csight_dispatcher_login
API_DATABASE_PASSWORD_HOST_FILE=
WORKER_DATABASE_PASSWORD_HOST_FILE=
DISPATCHER_DATABASE_PASSWORD_HOST_FILE=
# Must be true for limited-pilot qualification. When true, runtime connections
# fail before use if the login is superuser/BYPASSRLS or lacks its process group.
DATABASE_RLS_REQUIRED=false
RABBITMQ_DEFAULT_USER=csight
RABBITMQ_DEFAULT_PASS=change-me-for-local-development
RABBITMQ_URL=amqp://csight:change-me-for-local-development@127.0.0.1:5672//
MINIO_ENDPOINT=127.0.0.1:9000
# Hostname clients use in generated presigned URLs; no URL scheme or path
MINIO_PRESIGNED_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=csight-local
MINIO_SECRET_KEY=change-me-for-local-development
MINIO_BUCKET=csight-evidence
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PRESIGNED_SECURE=false
SIGNED_URL_TTL_SECONDS=900

# Evidence upload validation
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
MAX_IMAGE_PIXELS=40000000
EVIDENCE_IMAGE_SANITIZATION_ENABLED=false
EVIDENCE_MALWARE_SCANNER=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
# Local/test default. Non-local deployments must provide an approved version and duration.
SENSITIVE_PAYLOAD_RETENTION_POLICY_VERSION=development/30d
SENSITIVE_PAYLOAD_RETENTION_DAYS=30
# Disabled in the demo. A single-customer pilot must explicitly set its tenant UUID and approved
# retention pair before starting the opt-in `privacy-lifecycle` maintenance profile. This scheduler
# only purges expired DB prose; it never reconciles or deletes MinIO objects.
PRIVACY_LIFECYCLE_AUTOMATION_ENABLED=false
PRIVACY_LIFECYCLE_TENANT_ID=
PRIVACY_LIFECYCLE_INTERVAL_SECONDS=3600
PRIVACY_LIFECYCLE_BATCH_SIZE=500
PRIVACY_LIFECYCLE_MAX_BATCHES_PER_SWEEP=20

# Localhost-only published ports (Docker Compose)
API_PORT=8000
WEB_PORT=8080
WEB_MAX_UPLOAD_BODY=12m
POSTGRES_PORT=5432
POSTGRES_WAL_ARCHIVE_PATH=postgres-wal-archive
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CSIGHT_IMAGE_TAG=dev

# Analysis providers. The default Mock path performs no external GPU calls.
LLM_PROVIDER=mock
VISION_PROVIDER=mock
VISION_MOCK_MODE=success_single_defect
VISION_TASK=QUALITY_AND_DEFECT_DETECTION
# Required for binary mock/remote modes; E3 report-frozen demo value:
# VISION_ASSESSMENT_EXPECTED_THRESHOLD=0.8984375
LLM_BASE_URL=http://llm.invalid
LLM_API_KEY=
LLM_MODEL_ID=csight-mock-llm
LLM_MODEL_VERSION=0.1.0
# Optional immutable model artifact or deployment revision
LLM_MODEL_REVISION=
# Production vLLM must use a release-eligible Ed25519-signed manifest. Keep this
# disabled for the Mock demo and until the 4090 qualification gate passes.
MODEL_RELEASE_ENFORCEMENT=false
# Immutable per-task route enforcement is opt-in. When enabled, API resolves the
# active route and the model Worker must set an exact deployment identity.
MODEL_ROUTE_ENFORCEMENT=false
# MODEL_ROUTE_DEPLOYMENT_ID=onprem-4090-primary
MODEL_RELEASE_SIGNING_PUBLIC_KEY_FILE=
MODEL_RELEASE_SIGNING_KEY_ID=
LLM_ARTIFACT_CONTENT_DIGEST=
LLM_RUNTIME_IMAGE_DIGEST=
LLM_DEPENDENCY_LOCK_DIGEST=
LLM_SBOM_DIGEST=
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_OUTPUT_CHARS=20000
LLM_MAX_INPUT_CHARS=20000
LLM_TEMPERATURE=0
LLM_TLS_VERIFY=true
# Qualified Sprint 2.5 deployment identity (use only with a private authenticated endpoint):
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://private-tailscale-host:18000/v1
# LLM_MODEL_ID=csight-qwen3.8-27b
# LLM_MODEL_VERSION=Qwen3.8-27B
# LLM_MODEL_REVISION=63768c10df38c0395e12ef49edac1bd539eaeeea
# Local MLX PoC (host-native server; Docker clients must not use 127.0.0.1):
# LLM_PROVIDER=mlx
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL_ID=<absolute-pinned-snapshot-path-resolved-by-the-local-runner>
# LLM_MODEL_VERSION=Qwen3.5-9B-MLX-4bit
# LLM_MODEL_REVISION=938d8919941c6e7efd3c7150eff7fe9d12afa631
# LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_READ_TIMEOUT_SECONDS=180
# LLM_MAX_OUTPUT_TOKENS=512
VISION_BASE_URL=http://vision.invalid
VISION_API_KEY=
VISION_MODEL_ID=csight-mock-vision
VISION_MODEL_VERSION=0.1.0
VISION_MODEL_REVISION=
VISION_CONNECT_TIMEOUT_SECONDS=5
VISION_READ_TIMEOUT_SECONDS=120
VISION_MAX_IMAGE_BYTES=10485760
VISION_TLS_VERIFY=true

# Analysis task leases, worker limits, and durable outbox dispatch
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX_SECONDS=60
CELERY_WORKER_CONCURRENCY=2
ANALYSIS_TASK_SOFT_TIME_LIMIT_SECONDS=150
ANALYSIS_TASK_HARD_TIME_LIMIT_SECONDS=180
ANALYSIS_STAGE_LEASE_SECONDS=300
ANALYSIS_OUTBOX_POLL_INTERVAL_SECONDS=1
ANALYSIS_OUTBOX_BATCH_SIZE=100
ANALYSIS_OUTBOX_CLAIM_SECONDS=30
ANALYSIS_OUTBOX_MAX_ATTEMPTS=10
ANALYSIS_OUTBOX_RETRY_BASE_SECONDS=1
ANALYSIS_OUTBOX_RETRY_MAX_SECONDS=60

# Sprint 4A reference-data builds are local deterministic file operations and require no secrets.
# External Qwen evaluation remains opt-in and is not run by the reference self-check commands.

# Sprint 4B private host-native embedding service. It is not part of Core readiness.
EMBEDDING_BASE_URL=http://host.docker.internal:8091
EMBEDDING_TIMEOUT_SECONDS=30
RERANKER_BASE_URL=http://host.docker.internal:8092
RERANKER_TIMEOUT_SECONDS=120
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_SECONDS=30

# Sprint 4C-2 reuses LLM_* and EMBEDDING_* settings. The policy-retrieval queue carries IDs only.
# A real Qwen endpoint is opt-in; Mock output is contract evidence, never qualification data.

# Sprint 5B uses the existing PostgreSQL/RabbitMQ settings and a dedicated `human-review` queue.
# Its event carries identifiers only; no decision provider or external action credential is used.
# Sprint 5C adds two identifier-only queues and a network-free DRY_RUN adapter. No external Action
# credential is accepted; LIVE execution remains disabled.
